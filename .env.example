# ============================================================
#  Variables d'environnement — ERP EMUCI / StockApp
#  Copier ces clés dans Render > Web Service > Environment.
#  NE JAMAIS committer les vraies valeurs.
# ============================================================

# --- Base de données PostgreSQL (Neon) ---
# Récupérées depuis la connection string Neon :
# postgresql://<USER>:<PASS>@<HOST>/<DB>?sslmode=require
DB_HOST=ep-xxxxxxxx.eu-central-1.aws.neon.tech
DB_PORT=5432
DB_NAME=stockapp
DB_USER=votre_user_neon
DB_PASS=votre_mot_de_passe_neon
DB_SSLMODE=require

# --- Application ---
APP_URL=https://votre-service.onrender.com
APP_TIMEZONE=Africa/Abidjan
